# =============================================================
# SOLbot Configuration
# =============================================================
# IMPORTANT: Copy this file to .env and fill in your values
#   cp .env.example .env
#
# NEVER commit your .env file! It contains your private key.
# =============================================================

# Your Solana wallet private key (base58 encoded)
# Export from Phantom: Settings > Security > Export Private Key
SOLANA_PRIVATE_KEY=

# RPC endpoint (mainnet-beta or your own RPC provider)
# Free: https://api.mainnet-beta.solana.com
# Recommended paid: Helius, QuickNode, Triton
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Network: mainnet-beta | devnet | testnet
SOLANA_NETWORK=mainnet-beta

# Trading settings
SLIPPAGE_BPS=50
MAX_SOL_PER_TRADE=0.1

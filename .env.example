# =============================================================
# SOLbot Configuration
# =============================================================
#   cp .env.example .env
# =============================================================

# JWT secret (auto-generated if empty, set for persistence across restarts)
JWT_SECRET=

# RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Network
SOLANA_NETWORK=mainnet-beta

# Trading settings
SLIPPAGE_BPS=50
MAX_SOL_PER_TRADE=0.1

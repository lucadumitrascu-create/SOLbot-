# =============================================================
# SOLbot Custodial Engine Configuration
# =============================================================
# IMPORTANT: Copy this file to .env and fill in your values
#   cp .env.example .env
#
# NEVER commit your .env file!
# =============================================================

# Master encryption key for user private keys (AES-256-GCM)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=

# JWT secret for auth tokens (auto-generated if empty, but set for persistence across restarts)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# RPC endpoint (mainnet-beta or your own RPC provider)
# Free: https://api.mainnet-beta.solana.com
# Recommended paid: Helius, QuickNode, Triton
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Network: mainnet-beta | devnet | testnet
SOLANA_NETWORK=mainnet-beta

# Trading settings
SLIPPAGE_BPS=50
MAX_SOL_PER_TRADE=0.1

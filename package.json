{
  "name": "solbot-pro",
  "version": "1.0.0",
  "private": true,
  "description": "SOLbot Pro - Solana memecoin trading toolkit",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @solbot/web dev",
    "dev:api": "pnpm --filter @solbot/api dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @solbot/web build",
    "build:api": "pnpm --filter @solbot/api build",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
